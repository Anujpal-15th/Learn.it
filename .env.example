# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# PostgreSQL connection string (Neon, Vercel Postgres, or local).
# Example (Neon): postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Secret used to sign JWT session tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Google OAuth ("Continue with Google" on /login and /signup) ---
# From a Google Cloud Console OAuth 2.0 Client (Web application type).
# Authorized redirect URI must be: <your-deployed-url>/api/auth/google/callback
# (and http://localhost:3000/api/auth/google/callback for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
